@using GlassesShop.Services
@model List<OrderListItemVM>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    var currentStatus = ViewBag.CurrentStatus as string;
    var statuses = new[] { "Chờ xác nhận", "Đã xác nhận", "Đang giao", "Đã giao", "Đã hủy" };
}

<div class="container mt-4">
    <h4 class="section-title mb-3">ĐƠN HÀNG CỦA TÔI</h4>

    <ul class="nav nav-pills mb-3 flex-wrap gap-1">
        <li class="nav-item">
            <a class="nav-link @(string.IsNullOrEmpty(currentStatus) ? "active" : "")"
               asp-action="Index">Tất cả</a>
        </li>
        @foreach (var s in statuses)
        {
            <li class="nav-item">
                <a class="nav-link @(currentStatus == s ? "active" : "")"
                   asp-action="Index" asp-route-status="@s">@s</a>
            </li>
        }
    </ul>

    @if (Model.Count == 0)
    {
        <div class="card p-5 text-center">
            <i class="bi bi-bag-x display-1 text-muted"></i>
            <h5 class="mt-3">Chưa có đơn hàng nào</h5>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-2">Mua sắm ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th class="text-center">Số SP</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Thanh toán</th>
                            <th class="text-center">Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@order.OrderID</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">@order.ItemCount</td>
                                <td class="text-end fw-bold price-text">@order.TotalAmount.ToVnd()</td>
                                <td class="text-center">
                                    <div class="small">@order.PaymentMethod</div>
                                    <span class="badge @OrderService.GetPaymentBadgeClass(order.PaymentStatus)">
                                        @order.PaymentStatus
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @OrderService.GetStatusBadgeClass(order.OrderStatus)">
                                        @order.OrderStatus
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Details" asp-route-id="@order.OrderID">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>