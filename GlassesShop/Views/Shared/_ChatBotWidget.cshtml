<button type="button" id="chatbotToggleBtn" class="chatbot-toggle-btn" title="Tư vấn chọn kính">
    <i class="bi bi-chat-dots-fill"></i>
</button>

<div id="chatbotWindow" class="chatbot-window d-none">
    <div class="chatbot-header">
        <div>
            <i class="bi bi-eyeglasses me-1"></i>
            <span class="fw-semibold">Trợ lý tư vấn chọn kính</span>
        </div>
        <button type="button" id="chatbotCloseBtn" class="chatbot-close-btn" title="Đóng">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div id="chatbotBody" class="chatbot-body"></div>

    <div class="chatbot-footer">
        <button type="button" id="chatbotRestartBtn" class="btn btn-sm btn-outline-secondary w-100">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Bắt đầu lại
        </button>
    </div>
</div>