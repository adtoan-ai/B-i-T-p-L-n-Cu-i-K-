@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<div class="container text-center py-5">
    <i class="bi bi-exclamation-octagon display-1 text-warning"></i>
    <h2 class="mt-3">Đã có lỗi xảy ra</h2>
    <p class="text-muted">
        Hệ thống đang gặp sự cố. Vui lòng thử lại sau ít phút.
    </p>
    @if (Model != null && Model.ShowRequestId)
    {
        <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house me-1"></i>Về trang chủ
    </a>
</div>