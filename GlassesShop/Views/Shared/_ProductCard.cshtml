@model ProductCardVM

<div class="card product-card h-100">
    <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductID">
        <img src="@Model.MainImageUrl" class="card-img-top product-thumb"
             alt="@Model.ProductName" onerror="this.onerror=null;this.src='/images/no-image.png';" />
    </a>
    <div class="card-body d-flex flex-column">
        <div class="small text-muted mb-1">@Model.BrandName &bull; @Model.Style</div>
        <h6 class="card-title flex-grow-1">
            <a class="text-decoration-none text-dark"
               asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductID">
                @Model.ProductName
            </a>
        </h6>
        <div class="price-text mb-2">
            @if (Model.HasPriceRange)
            {
                @($"{Model.MinPrice.ToVnd()} - {Model.MaxPrice.ToVnd()}")
            }
            else
            {
                @Model.MinPrice.ToVnd()
            }
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <span class="badge bg-light text-dark border">@Model.ColorCount màu</span>
            @if (Model.TotalStock > 0)
            {
                <span class="badge bg-success">Còn hàng</span>
            }
            else
            {
                <span class="badge bg-secondary">Hết hàng</span>
            }
        </div>
        <a class="btn btn-outline-primary btn-sm mt-3"
           asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductID">
            Xem chi tiết
        </a>
    </div>
</div>