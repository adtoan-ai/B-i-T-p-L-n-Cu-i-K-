@model ChangePasswordVM
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container">
    <div class="card auth-card">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-key me-2"></i>ĐỔI MẬT KHẨU</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 d-none"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <div class="password-wrapper">
                        <input asp-for="CurrentPassword" class="form-control" />
                        <button type="button" class="password-toggle-btn" tabindex="-1" aria-label="Hiện mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="password-wrapper">
                        <input asp-for="NewPassword" class="form-control" />
                        <button type="button" class="password-toggle-btn" tabindex="-1" aria-label="Hiện mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="password-wrapper">
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <button type="button" class="password-toggle-btn" tabindex="-1" aria-label="Hiện mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}