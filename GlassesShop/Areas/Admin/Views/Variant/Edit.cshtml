@model VariantFormVM
@{
    ViewData["Title"] = "Sửa biến thể";
}

<h1 class="page-title">SỬA BIẾN THỂ #@Model.VariantID</h1>
<p class="text-muted">Sản phẩm: <strong>@Model.ProductName</strong></p>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card admin-card">
            <div class="card-header">THÔNG TIN BIẾN THỂ</div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="VariantID" />
                    <input type="hidden" asp-for="ProductID" />
                    <input type="hidden" asp-for="ProductName" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Color" class="form-label fw-semibold"></label>
                            <input asp-for="Color" class="form-control" />
                            <span asp-validation-for="Color" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <input asp-for="Price" type="number" step="1000" min="1" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
                            <input asp-for="StockQuantity" type="number" min="0" class="form-control" />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Thêm ảnh mới (chọn nhiều)</label>
                            <input type="file" name="images" id="imageInput" class="form-control"
                                   accept="image/*" multiple />
                            <div id="previewBox" class="d-flex flex-wrap gap-2 mt-2"></div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Cập nhật
                        </button>
                        <a asp-action="Index" asp-route-productId="@Model.ProductID" class="btn btn-outline-secondary">
                            Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card admin-card">
            <div class="card-header">ẢNH HIỆN CÓ (@Model.ExistingImages.Count)</div>
            <div class="card-body">
                @if (Model.ExistingImages.Count == 0)
                {
                    <p class="text-muted text-center mb-0 py-3">Chưa có ảnh nào cho biến thể này.</p>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="col-6">
                                <div class="image-item @(img.IsMain ? "is-main" : "")">
                                    <img src="@img.ImageUrl" onerror="this.src='/images/no-image.png'" />
                                    @if (img.IsMain)
                                    {
                                        <span class="badge bg-primary main-badge">Ảnh chính</span>
                                    }
                                    <div class="image-actions">
                                        @if (!img.IsMain)
                                        {
                                            <form asp-action="SetMainImage" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="imageId" value="@img.ImageID" />
                                                <input type="hidden" name="variantId" value="@Model.VariantID" />
                                                <button type="submit" class="btn btn-sm btn-light" title="Đặt làm ảnh chính">
                                                    <i class="bi bi-star"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="DeleteImage" method="post" class="d-inline"
                                              onsubmit="return confirm('Xóa ảnh này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="imageId" value="@img.ImageID" />
                                            <input type="hidden" name="variantId" value="@Model.VariantID" />
                                            <button type="submit" class="btn btn-sm btn-danger" title="Xóa ảnh">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#imageInput').on('change', function() {
            var box = $('#previewBox').empty();
            $.each(this.files, function(i, file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    box.append('<img src="' + e.target.result + '" class="preview-thumb" />');
                };
                reader.readAsDataURL(file);
            });
        });
    </script>
}