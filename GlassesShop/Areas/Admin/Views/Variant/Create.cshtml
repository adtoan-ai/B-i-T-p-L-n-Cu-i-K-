@model VariantFormVM
@{
    ViewData["Title"] = "Thêm biến thể";
}

<h1 class="page-title">THÊM BIẾN THỂ</h1>
<p class="text-muted">Sản phẩm: <strong>@Model.ProductName</strong></p>

<div class="card admin-card">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductID" />
            <input type="hidden" asp-for="ProductName" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Color" class="form-label fw-semibold"></label>
                    <input asp-for="Color" class="form-control" placeholder="VD: Đen, Vàng Gold" />
                    <span asp-validation-for="Color" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <input asp-for="Price" type="number" step="1000" min="1" class="form-control" placeholder="2500000" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
                    <input asp-for="StockQuantity" type="number" min="0" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Ảnh sản phẩm (chọn nhiều ảnh)</label>
                    <input type="file" name="images" id="imageInput" class="form-control"
                           accept="image/*" multiple />
                    <div class="form-text">Chấp nhận jpg, png, webp, gif. Tối đa 5MB mỗi ảnh. Ảnh đầu tiên là ảnh chính.</div>
                    <div id="previewBox" class="d-flex flex-wrap gap-2 mt-2"></div>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Lưu biến thể
                </button>
                <a asp-action="Index" asp-route-productId="@Model.ProductID" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#imageInput').on('change', function() {
            var box = $('#previewBox').empty();
            $.each(this.files, function(i, file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    box.append('<img src="' + e.target.result + '" class="preview-thumb" />');
                };
                reader.readAsDataURL(file);
            });
        });
    </script>
}