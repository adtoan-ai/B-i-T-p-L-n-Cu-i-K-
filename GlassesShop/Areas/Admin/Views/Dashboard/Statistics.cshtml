@model RevenueStatisticsVM
@{
    ViewData["Title"] = "Thống kê doanh thu";
}

<h1 class="page-title">THỐNG KÊ DOANH THU</h1>

<div class="card admin-card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Statistics" class="row g-3 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label class="form-label small fw-semibold">Từ ngày</label>
                <input type="date" name="fromDate" class="form-control"
                       value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-sm-4 col-md-3">
                <label class="form-label small fw-semibold">Đến ngày</label>
                <input type="date" name="toDate" class="form-control"
                       value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-sm-4 col-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>Xem thống kê
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dc2626"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-value">@Model.TotalRevenue.ToVnd()</div>
                <div class="stat-label">Doanh thu (đơn đã giao)</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#059669"><i class="bi bi-receipt"></i></div>
            <div>
                <div class="stat-value">@Model.TotalOrders</div>
                <div class="stat-label">Đơn hàng đã giao</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#2563eb"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="stat-value">@Model.TotalProductsSold</div>
                <div class="stat-label">Sản phẩm đã bán</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card admin-card">
            <div class="card-header">
                <i class="bi bi-bar-chart-line me-1"></i>TOP 5 SẢN PHẨM BÁN CHẠY
            </div>
            <div class="card-body">
                @if (Model.TopProducts.Count == 0)
                {
                    <p class="text-muted text-center py-4 mb-0">Không có dữ liệu bán hàng trong khoảng thời gian này</p>
                }
                else
                {
                    <canvas id="topProductsChart" height="280"></canvas>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="card admin-card">
            <div class="card-header">
                <i class="bi bi-list-ol me-1"></i>CHI TIẾT TOP 5
            </div>
            <div class="table-responsive">
                <table class="table admin-table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Sản phẩm</th>
                            <th class="text-end">SL bán</th>
                            <th class="text-end">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopProducts.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
                        }
                        else
                        {
                            var rank = 1;
                            @foreach (var p in Model.TopProducts)
                            {
                                <tr>
                                    <td class="fw-bold">@rank</td>
                                    <td>@p.ProductName</td>
                                    <td class="text-end">@p.QuantitySold</td>
                                    <td class="text-end fw-semibold">@p.Revenue.ToVnd()</td>
                                </tr>
                                rank++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.TopProducts.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
            const topProductsLabels = @Html.Raw(Json.Serialize(Model.TopProducts.Select(p => p.ProductName)));
            const topProductsData = @Html.Raw(Json.Serialize(Model.TopProducts.Select(p => p.QuantitySold)));

            const ctx = document.getElementById('topProductsChart');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: topProductsLabels,
                    datasets: [{
                        label: 'Số lượng đã bán',
                        data: topProductsData,
                        backgroundColor: '#2563eb',
                        borderRadius: 6,
                        maxBarThickness: 60
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (item) => `Đã bán: ${item.raw}`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    }
                }
            });
        </script>
    }
}