@model ProductFormVM
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="page-title mb-0">SỬA SẢN PHẨM #@Model.ProductID</h1>
    <a asp-controller="Variant" asp-action="Index" asp-route-productId="@Model.ProductID" class="btn btn-info btn-sm">
        <i class="bi bi-palette me-1"></i>Quản lý biến thể & ảnh
    </a>
</div>

<div class="card admin-card mt-3">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductID" />

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="ProductName" class="form-label fw-semibold"></label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Style" class="form-label fw-semibold"></label>
                    <input asp-for="Style" class="form-control" />
                    <span asp-validation-for="Style" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryID" class="form-label fw-semibold"></label>
                    <select asp-for="CategoryID" class="form-select">
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.CategoryID" selected="@(c.CategoryID == Model.CategoryID)">@c.CategoryName</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BrandID" class="form-label fw-semibold"></label>
                    <select asp-for="BrandID" class="form-select">
                        @foreach (var b in Model.Brands)
                        {
                            <option value="@b.BrandID" selected="@(b.BrandID == Model.BrandID)">@b.BrandName</option>
                        }
                    </select>
                    <span asp-validation-for="BrandID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Material" class="form-label fw-semibold"></label>
                    <input asp-for="Material" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Cập nhật
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}