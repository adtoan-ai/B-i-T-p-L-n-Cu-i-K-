@model ProductFormVM
@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<h1 class="page-title">THÊM SẢN PHẨM MỚI</h1>

<div class="card admin-card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="ProductName" class="form-label fw-semibold"></label>
                    <input asp-for="ProductName" class="form-control" placeholder="VD: Kính Ray-Ban Aviator Classic" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Style" class="form-label fw-semibold"></label>
                    <input asp-for="Style" class="form-control" placeholder="VD: Phi công, Vuông, Mắt mèo" />
                    <span asp-validation-for="Style" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryID" class="form-label fw-semibold"></label>
                    <select asp-for="CategoryID" class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.CategoryID">@c.CategoryName</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BrandID" class="form-label fw-semibold"></label>
                    <select asp-for="BrandID" class="form-select">
                        <option value="">-- Chọn thương hiệu --</option>
                        @foreach (var b in Model.Brands)
                        {
                            <option value="@b.BrandID">@b.BrandName</option>
                        }
                    </select>
                    <span asp-validation-for="BrandID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Material" class="form-label fw-semibold"></label>
                    <input asp-for="Material" class="form-control" placeholder="VD: Kim loại, Nhựa Acetate" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0 small">
                <i class="bi bi-info-circle me-1"></i>
                Sau khi lưu, bạn sẽ được chuyển tới trang thêm <strong>biến thể màu sắc</strong> (giá, tồn kho, ảnh).
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Lưu và thêm biến thể
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}