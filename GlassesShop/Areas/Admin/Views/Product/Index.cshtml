@model List<AdminProductListVM>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var keyword = ViewBag.Keyword as string;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="page-title mb-0">QUẢN LÝ SẢN PHẨM</h1>
    <div class="d-flex gap-2">
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text" name="keyword" class="form-control form-control-sm"
                   placeholder="Tìm tên, thương hiệu..." value="@keyword" style="width:220px" />
            <button type="submit" class="btn btn-sm btn-outline-secondary ms-1">
                <i class="bi bi-search"></i>
            </button>
        </form>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm
        </a>
    </div>
</div>

<div class="card admin-card mt-3">
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px">Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Thương hiệu</th>
                    <th>Kiểu dáng</th>
                    <th class="text-center">Biến thể</th>
                    <th class="text-center">Tồn kho</th>
                    <th class="text-end">Giá từ</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width:180px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Không có sản phẩm nào</td></tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <img src="@p.MainImageUrl" class="admin-thumb"
                                     onerror="this.src='/images/no-image.png'" />
                            </td>
                            <td>
                                <div class="fw-semibold">@p.ProductName</div>
                                <div class="small text-muted">@p.CategoryName</div>
                            </td>
                            <td>@p.BrandName</td>
                            <td>@p.Style</td>
                            <td class="text-center">
                                <a asp-controller="Variant" asp-action="Index" asp-route-productId="@p.ProductID"
                                   class="badge bg-primary text-decoration-none">@p.VariantCount màu</a>
                            </td>
                            <td class="text-center">
                                <span class="badge @(p.TotalStock > 5 ? "bg-success" : "bg-danger")">@p.TotalStock</span>
                            </td>
                            <td class="text-end fw-semibold">@p.MinPrice.ToVnd()</td>
                            <td class="text-center">
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ngừng bán</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-info"
                                   asp-controller="Variant" asp-action="Index" asp-route-productId="@p.ProductID"
                                   title="Quản lý biến thể">
                                    <i class="bi bi-palette"></i>
                                </a>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Edit" asp-route-id="@p.ProductID" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@p.ProductID" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Bật/tắt bán">
                                        <i class="bi bi-power"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@p.ProductID" method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa sản phẩm này và toàn bộ biến thể, ảnh?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>