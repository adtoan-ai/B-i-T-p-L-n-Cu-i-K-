@model List<AdminCustomerVM>
@{
    ViewData["Title"] = "Tài khoản khách hàng";
    var keyword = ViewBag.Keyword as string;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="page-title mb-0">TÀI KHOẢN KHÁCH HÀNG</h1>
    <form asp-action="Index" method="get" class="d-flex">
        <input type="text" name="keyword" class="form-control form-control-sm"
               placeholder="Tên, SĐT, email..." value="@keyword" style="width:240px" />
        <button type="submit" class="btn btn-sm btn-outline-secondary ms-1">
            <i class="bi bi-search"></i>
        </button>
    </form>
</div>

<div class="card admin-card mt-3">
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ tên</th>
                    <th class="text-center">Giới tính</th>
                    <th>Điện thoại</th>
                    <th>Email</th>
                    <th class="text-center">Số đơn</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width:150px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Không có khách hàng nào</td></tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CustomerID</td>
                            <td class="fw-semibold">@c.Username</td>
                            <td>@c.FullName</td>
                            <td class="text-center">@c.Gender</td>
                            <td>@c.NumberPhone</td>
                            <td class="small">@c.Email</td>
                            <td class="text-center">
                                <span class="badge bg-primary">@c.OrderCount</span>
                            </td>
                            <td class="text-center">
                                @if (c.IsLocked)
                                {
                                    <span class="badge bg-secondary">Đã khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Details" asp-route-id="@c.CustomerID" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <form asp-action="ToggleLock" asp-route-id="@c.CustomerID" method="post" class="d-inline"
                                      onsubmit="return confirm('@(c.IsLocked ? "Mở khóa" : "Khóa") tài khoản @c.Username?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(c.IsLocked ? "btn-outline-success" : "btn-outline-danger")">
                                        <i class="bi @(c.IsLocked ? "bi-unlock" : "bi-lock")"></i>
                                        @(c.IsLocked ? "Mở" : "Khóa")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>