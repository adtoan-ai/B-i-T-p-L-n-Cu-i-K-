@model Brand
@{
    ViewData["Title"] = "Thêm thương hiệu";
}

<h1 class="page-title">THÊM THƯƠNG HIỆU MỚI</h1>

<div class="card admin-card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Tên thương hiệu <span class="text-danger">*</span></label>
                <input asp-for="BrandName" class="form-control" placeholder="VD: Ray-Ban" />
                <span asp-validation-for="BrandName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i>Lưu thương hiệu
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}