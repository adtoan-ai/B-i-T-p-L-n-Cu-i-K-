@model DashboardVM
@{
    ViewData["Title"] = "Tổng quan";
}

<h1 class="page-title">TỔNG QUAN BÁN HÀNG</h1>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#d97706"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-value">@Model.PendingOrders</div>
                <div class="stat-label">Đơn chờ xác nhận</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#2563eb"><i class="bi bi-truck"></i></div>
            <div>
                <div class="stat-value">@ViewBag.ShippingCount</div>
                <div class="stat-label">Đơn đang giao</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#059669"><i class="bi bi-person-check"></i></div>
            <div>
                <div class="stat-value">@ViewBag.MyOrderCount</div>
                <div class="stat-label">Đơn tôi phụ trách</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#6b7280"><i class="bi bi-receipt"></i></div>
            <div>
                <div class="stat-value">@Model.TotalOrders</div>
                <div class="stat-label">Tổng đơn (@Model.CancelledOrders đã hủy)</div>
            </div>
        </div>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>ĐƠN HÀNG GẦN ĐÂY</span>
        <a asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>SĐT nhận</th>
                    <th>Ngày đặt</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentOrders.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa có đơn hàng nào</td></tr>
                }
                else
                {
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td class="fw-bold">#@o.OrderID</td>
                            <td>@o.CustomerName</td>
                            <td>@o.ReceiverPhone</td>
                            <td class="small">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end fw-semibold">@o.TotalAmount.ToVnd()</td>
                            <td class="text-center">
                                <span class="badge @OrderService.GetStatusBadgeClass(o.OrderStatus)">@o.OrderStatus</span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Order" asp-action="Details" asp-route-id="@o.OrderID">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>