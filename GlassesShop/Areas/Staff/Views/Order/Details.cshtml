@model OrderDetailVM
@{
    ViewData["Title"] = $"Đơn hàng #{Model.OrderID}";
    var isCancelled = Model.OrderStatus == "Đã hủy";
    var isDelivered = Model.OrderStatus == "Đã giao";
    var nextStatuses = new[] { "Đã xác nhận", "Đang giao", "Đã giao" };
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="page-title mb-0">CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Danh sách đơn
    </a>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-8">
        <div class="card admin-card mb-3">
            <div class="card-header">SẢN PHẨM ĐÃ ĐẶT</div>
            <div class="table-responsive">
                <table class="table admin-table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">Đơn giá</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@item.ImageUrl" class="admin-thumb"
                                             onerror="this.src='/images/no-image.png'" />
                                        <div>
                                            <div class="fw-semibold">@item.ProductName</div>
                                            <div class="small text-muted">@item.BrandName &bull; Màu: @item.Color</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">@item.UnitPrice.ToVnd()</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end fw-bold">@item.SubTotal.ToVnd()</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">TỔNG CỘNG</td>
                            <td class="text-end fs-5 price-text fw-bold">@Model.TotalAmount.ToVnd()</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card admin-card">
            <div class="card-header">CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG</div>
            <div class="card-body">
                @if (isCancelled)
                {
                    <div class="alert alert-danger mb-0">
                        <i class="bi bi-x-octagon me-1"></i>Đơn hàng đã bị hủy, không thể cập nhật.
                    </div>
                }
                else if (isDelivered)
                {
                    <div class="alert alert-success mb-0">
                        <i class="bi bi-check-circle me-1"></i>Đơn hàng đã giao thành công.
                    </div>
                }
                else
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.OrderID" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Chuyển sang trạng thái</label>
                            <select name="newStatus" class="form-select">
                                @foreach (var s in nextStatuses)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i>Cập nhật trạng thái
                            </button>
                        </div>
                    </form>

                    <div class="alert alert-info mt-3 mb-0 small">
                        <i class="bi bi-info-circle me-1"></i>
                        Khi cập nhật, hệ thống sẽ ghi nhận bạn là nhân viên phụ trách đơn này.
                        Đơn chuyển sang <strong>"Đã giao"</strong> mà thanh toán COD sẽ tự động ghi nhận đã thanh toán.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card admin-card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>TRẠNG THÁI</span>
                <span class="badge @OrderService.GetStatusBadgeClass(Model.OrderStatus)">@Model.OrderStatus</span>
            </div>
            <div class="card-body">
                <p class="mb-1"><span class="text-muted">Ngày đặt:</span> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="mb-0">
                    <span class="text-muted">NV phụ trách:</span>
                    <strong>@(Model.StaffName ?? "Chưa phân công")</strong>
                </p>
            </div>
        </div>

        <div class="card admin-card mb-3">
            <div class="card-header">KHÁCH HÀNG</div>
            <div class="card-body">
                <p class="mb-1"><span class="text-muted">Họ tên:</span> <strong>@Model.CustomerName</strong></p>
                <p class="mb-0"><span class="text-muted">Email:</span> @Model.CustomerEmail</p>
            </div>
        </div>

        <div class="card admin-card mb-3">
            <div class="card-header">GIAO HÀNG</div>
            <div class="card-body">
                <p class="mb-1"><span class="text-muted">Người nhận:</span> <strong>@Model.ReceiverName</strong></p>
                <p class="mb-1"><span class="text-muted">Điện thoại:</span> @Model.ReceiverPhone</p>
                <p class="mb-1"><span class="text-muted">Địa chỉ:</span> @Model.ShippingAddress</p>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <p class="mb-0"><span class="text-muted">Ghi chú:</span> @Model.Note</p>
                }
            </div>
        </div>

        <div class="card admin-card">
            <div class="card-header">THANH TOÁN</div>
            <div class="card-body">
                <p class="mb-1"><span class="text-muted">Phương thức:</span> <strong>@Model.PaymentMethod</strong></p>
                <p class="mb-1">
                    <span class="text-muted">Trạng thái:</span>
                    <span class="badge @OrderService.GetPaymentBadgeClass(Model.PaymentStatus)">@Model.PaymentStatus</span>
                </p>
                @if (!string.IsNullOrEmpty(Model.TransactionCode))
                {
                    <p class="mb-0"><span class="text-muted">Mã GD:</span> <code>@Model.TransactionCode</code></p>
                }
            </div>
        </div>
    </div>
</div>