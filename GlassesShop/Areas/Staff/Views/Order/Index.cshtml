@model List<OrderListItemVM>
@{
    var isMyOrders = ViewBag.IsMyOrders != null && (bool)ViewBag.IsMyOrders;
    ViewData["Title"] = isMyOrders ? "Đơn tôi phụ trách" : "Danh sách đơn hàng";
    var currentStatus = ViewBag.CurrentStatus as string;
    var keyword = ViewBag.Keyword as string;
    var statuses = new[] { "Chờ xác nhận", "Đã xác nhận", "Đang giao", "Đã giao", "Đã hủy" };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="page-title mb-0">@(isMyOrders ? "ĐƠN TÔI PHỤ TRÁCH" : "DANH SÁCH ĐƠN HÀNG")</h1>
    @if (!isMyOrders)
    {
        <form asp-action="Index" method="get" class="d-flex">
            <input type="hidden" name="status" value="@currentStatus" />
            <input type="text" name="keyword" class="form-control form-control-sm"
                   placeholder="Tên KH, SĐT..." value="@keyword" style="width:220px" />
            <button type="submit" class="btn btn-sm btn-outline-secondary ms-1">
                <i class="bi bi-search"></i>
            </button>
        </form>
    }
</div>

@if (!isMyOrders)
{
    <ul class="nav nav-pills my-3 flex-wrap gap-1">
        <li class="nav-item">
            <a class="nav-link @(string.IsNullOrEmpty(currentStatus) ? "active" : "")"
               asp-action="Index" asp-route-keyword="@keyword">Tất cả</a>
        </li>
        @foreach (var s in statuses)
        {
            <li class="nav-item">
                <a class="nav-link @(currentStatus == s ? "active" : "")"
                   asp-action="Index" asp-route-status="@s" asp-route-keyword="@keyword">@s</a>
            </li>
        }
    </ul>
}

<div class="card admin-card mt-3">
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>SĐT nhận</th>
                    <th>Ngày đặt</th>
                    <th class="text-center">Số SP</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center">Thanh toán</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Không có đơn hàng nào</td></tr>
                }
                else
                {
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@o.OrderID</td>
                            <td>@o.CustomerName</td>
                            <td>@o.ReceiverPhone</td>
                            <td class="small">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">@o.ItemCount</td>
                            <td class="text-end fw-semibold">@o.TotalAmount.ToVnd()</td>
                            <td class="text-center">
                                <div class="small">@o.PaymentMethod</div>
                                <span class="badge @OrderService.GetPaymentBadgeClass(o.PaymentStatus)">@o.PaymentStatus</span>
                            </td>
                            <td class="text-center">
                                <span class="badge @OrderService.GetStatusBadgeClass(o.OrderStatus)">@o.OrderStatus</span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Details" asp-route-id="@o.OrderID">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>