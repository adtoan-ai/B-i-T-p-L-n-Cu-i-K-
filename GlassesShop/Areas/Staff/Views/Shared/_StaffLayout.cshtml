<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhân viên bán hàng</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <nav class="navbar navbar-dark staff-topbar fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-area="Staff" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-clipboard-check me-1"></i>NHÂN VIÊN BÁN HÀNG
            </a>
            <div class="d-flex align-items-center gap-3">
                <a class="text-white text-decoration-none small" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem website
                </a>
                <div class="dropdown">
                    <a class="text-white text-decoration-none dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i>@User.GetFullName()
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Staff" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Tổng quan
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Staff" asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt"></i> Danh sách đơn hàng
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Staff" asp-controller="Order" asp-action="Index" asp-route-status="Chờ xác nhận">
                        <i class="bi bi-hourglass-split"></i> Đơn chờ xác nhận
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Staff" asp-controller="Order" asp-action="MyOrders">
                        <i class="bi bi-person-check"></i> Đơn tôi phụ trách
                    </a>
                </li>
            </ul>
        </aside>

        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>